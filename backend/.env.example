# Database Configuration
# Format: postgresql://user:password@host:port/database
# Local backend example: postgresql://postgres:password@localhost:5432/meetsum
# Docker on Windows host example: postgresql://postgres:password@host.docker.internal:8000/meetsum
DATABASE_URL=postgresql://postgres:password@localhost:5432/meetsum

# JWT Configuration
# Secret key for signing JWT tokens - MUST change this in production!
JWT_SECRET_KEY=your-secret-key
#JWT_ALGORITHM=HS256
#JWT_EXPIRE_MINUTES=1440

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Default user/team configuration
# DEFAULT_OWNER_USER_ID=
# DEFAULT_TEAM_ID=

# Optional: Enable/disable meeting persistence to database (default: 1)
# PERSIST_MEETINGS=1

# API Server Configuration
# MEETSUM_API_HOST=127.0.0.1
# MEETSUM_API_PORT=8001

# Conda environment name (used by run.sh)
# MEETSUM_CONDA_ENV=meetSum

# Optional: OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=

# Optional: Other LLM provider keys
# ANTHROPIC_API_KEY=
# HUGGINGFACE_API_KEY=

